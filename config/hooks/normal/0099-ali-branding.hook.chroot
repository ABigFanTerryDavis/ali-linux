#!/bin/sh
set -e
# ALI Linux branding hook - runs inside chroot
# Overwrites base-files on every build so branding survives upgrades in the live system

cat > /etc/os-release <<'EOF'
PRETTY_NAME="ALI Linux 1.0"
NAME="ALI Linux"
VERSION_ID="1.0"
VERSION="1.0 (trixie-base)"
ID=ali
ID_LIKE=debian
HOME_URL="https://github.com/"
DEBIAN_VERSION_FULL=13
EOF

cat > /etc/lsb-release <<'EOF'
DISTRIB_ID="ALI Linux"
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=ali
DISTRIB_DESCRIPTION="ALI Linux 1.0"
EOF

echo "ali" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 ali
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

echo "ALI Linux 1.0 \\n \\l" > /etc/issue
echo "ALI Linux 1.0" > /etc/issue.net
echo "ALI Linux 1.0 - Debian trixie based." > /etc/motd

# LightDM greeter branding if present
if [ -d /etc/lightdm ]; then
  mkdir -p /etc/lightdm
  cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'EOF'
[greeter]
background=/usr/share/backgrounds/ali/ali-wallpaper.svg
theme-name=Greybird
icon-theme-name=elementary-xfce
font-name=Cantarell 11
xft-antialias=true
show-clock=true
clock-format=%H:%M
indicators=~host;~spacer;~clock;~spacer;~session;~a11y;~power
EOF
fi

# Simple wallpaper
mkdir -p /usr/share/backgrounds/ali
cat > /usr/share/backgrounds/ali/ali-wallpaper.svg <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080"><rect width="100%" height="100%" fill="#1a1d29"/><text x="50%" y="48%" font-family="sans-serif" font-size="120" fill="#ffffff" text-anchor="middle">ALI Linux</text><text x="50%" y="58%" font-family="sans-serif" font-size="36" fill="#8b93b8" text-anchor="middle">Debian based - XFCE</text></svg>
EOF

# fastfetch / neofetch logo override
mkdir -p /etc/skel/.config/fastfetch 2>/dev/null || true

echo "ALI branding applied"
