#!/bin/sh
set -e
# Rename visible bootloader strings from Debian -> ALI Linux in the binary stage
# Runs after lb binary prepares bootloaders

if [ -d binary/bootloaders ]; then
  grep -rl "Debian" binary/bootloaders 2>/dev/null | xargs -r sed -i 's/Debian GNU\/Linux/ALI Linux/g; s/Debian Live/ALI Linux Live/g; s/Debian/ALI/g' || true
fi

# GRUB EFI + syslinux menus live here in different live-build versions - cover both
for d in binary/boot/grub binary/syslinux binary/isolinux; do
  if [ -d "$d" ]; then
    grep -rl "Debian" "$d" 2>/dev/null | xargs -r sed -i 's/Debian GNU\/Linux/ALI Linux/g; s/Debian/ALI/g' || true
  fi
done

echo "ALI bootmenu rebrand done"
