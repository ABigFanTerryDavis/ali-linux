#!/bin/sh
# ali-info - system info splash for ALI Linux
cat /etc/os-release 2>/dev/null | head -n 4
echo "---"
hostname; uptime
echo "---"
if command -v fastfetch >/dev/null 2>&1; then
  fastfetch
elif command -v neofetch >/dev/null 2>&1; then
  neofetch
else
  uname -a
fi
echo "---"
df -h / | tail -n 1
free -h | head -n 2
