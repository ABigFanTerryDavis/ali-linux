#!/bin/sh
# ali-backup - home-folder backup with dice-named snapshots.
# usage: ali-backup [destdir] | ali-backup restore <snapshot.tgz> | ali-backup list [destdir] | ali-backup verify <snapshot.tgz>
# Default dest: /media/ali/*/ (first removable mount) else ~/Backups.
# Snapshot: home-<date>-<dice6>.tgz (excludes caches, trash, vaults stay encrypted).
# Turkish: ALI_LANG=tr
set -u

TR() {
    if [ "${ALI_LANG:-}" = "tr" ] || [ "${ALI_LANG:-}" = "TR" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

pick_dest() {
    for m in /media/ali/* /media/*/; do
        if [ -d "$m" ] && [ -w "$m" ]; then printf '%s' "$m"; return 0; fi
    done
    mkdir -p "$HOME/Backups"
    printf '%s' "$HOME/Backups"
}

case "${1:-}" in
    restore)
        snap="${2:?$(TR 'usage: ali-backup restore <snapshot.tgz>' 'kullanım: ali-backup restore <snapshot.tgz>')}"
        [ -f "$snap" ] || { echo "$(TR "no such snapshot: $snap" "böyle bir yedek yok: $snap")" >&2; exit 1; }
        printf '%s' "$(TR "Restore $snap over \$HOME? Type YES: " "\$HOME üzerine geri yüklensin mi? YES yaz: ")"
        read -r ans
        [ "$ans" = "YES" ] || { echo "$(TR 'aborted' 'vazgeçildi')"; exit 1; }
        tar -xzf "$snap" -C "$HOME" || exit 1
        echo "$(TR "restored: $snap" "geri yüklendi: $snap")"
        ;;
    list)
        ls -1 "${2:-$(pick_dest)}"/home-*.tgz 2>/dev/null || echo "$(TR '(no snapshots)' '(yedek yok)')"
        ;;
    verify)
        snap="${2:?$(TR 'usage: ali-backup verify <snapshot.tgz>' 'kullanım: ali-backup verify <snapshot.tgz>')}"
        [ -f "$snap" ] || { echo "$(TR "no such snapshot: $snap" "böyle bir yedek yok: $snap")" >&2; exit 1; }
        tar -tzf "$snap" >/dev/null || { echo "$(TR 'archive BROKEN' 'arşiv BOZUK')" >&2; exit 1; }
        n=$(tar -tzf "$snap" 2>/dev/null | wc -l)
        sum=$(sha256sum "$snap" 2>/dev/null | awk '{print $1}')
        echo "$(TR "OK: $n files, sha256 $sum" "TAMAM: $n dosya, sha256 $sum")"
        ;;
    *)
        dest="${1:-$(pick_dest)}"
        case "$dest" in *@*:*)
            command -v scp >/dev/null 2>&1 || { echo "$(TR 'needs openssh-client: sudo apt install openssh-client' 'openssh-client gerekli: sudo apt install openssh-client')" >&2; exit 1; }
            tmpd=$(mktemp -d) || exit 1
            tag=$(terry-dice hex 3 2>/dev/null || echo deadbe)
            snap="$tmpd/home-$(date +%F)-$tag.tgz"
            tar -czf "$snap" -C "$HOME" \
                --exclude=.cache --exclude=.local/share/Trash \
                --exclude=Backups --exclude=.thumbnails \
                . || { rm -rf "$tmpd"; exit 1; }
            if ! tar -tzf "$snap" >/dev/null 2>&1; then
                echo "$(TR 'backup written but verify FAILED, not sending' 'yedek yazıldı ama doğrulama BAŞARISIZ, gönderilmiyor')" >&2
                rm -rf "$tmpd"; exit 1
            fi
            if scp "$snap" "$dest" 2>/dev/null; then
                echo "$(TR "backed up to: $dest/$(basename $snap)" "yedeklendi: $dest/$(basename $snap)")"
            else
                echo "$(TR 'scp failed - snapshot kept at: ' 'scp başarısız - yedek şurada duruyor: ')$snap" >&2
                exit 1
            fi
            rm -rf "$tmpd"
            ;;
        *)
        mkdir -p "$dest" || exit 1
        tag=$(terry-dice hex 3 2>/dev/null || echo deadbe)
        snap="$dest/home-$(date +%F)-$tag.tgz"
        tar -czf "$snap" -C "$HOME" \
            --exclude=.cache --exclude=.local/share/Trash \
            --exclude=Backups --exclude=.thumbnails \
            . || exit 1
        if ! tar -tzf "$snap" >/dev/null 2>&1; then
            echo "$(TR 'backup written but verify FAILED, keeping anyway' 'yedek yazıldı ama doğrulama BAŞARISIZ, yine de saklanıyor')" >&2
        else
            echo "$(TR 'self-verify: OK' 'öz doğrulama: TAMAM')"
        fi
        echo "$(TR "backed up to: $snap" "yedeklendi: $snap")"
        ls -lh "$snap"
        ;;
        esac
esac
