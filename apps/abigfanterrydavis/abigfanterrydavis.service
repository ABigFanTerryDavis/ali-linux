[Unit]
Description=ALI fan - identity guardian (re-stamps ALI, hourly)
OnFailure=ali-fail@%n.service
Documentation=https://github.com/
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/abigfanterrydavis
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
