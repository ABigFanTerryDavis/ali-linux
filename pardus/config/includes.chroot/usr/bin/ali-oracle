#!/bin/sh
# ali-oracle - ask the oracle right now (prints WORD + today's verse).
# usage: ali-oracle
if [ -x /usr/bin/templeos ]; then
    /usr/bin/templeos --once >/dev/null 2>&1 || true
fi
if [ -f /run/templeos-oracle ]; then
    grep -a '^oracle=' /run/templeos-oracle | cut -d= -f2
    grep -a '^verse=' /run/templeos-oracle | cut -d= -f2-
else
    echo "the oracle is silent (templeos not running yet)"
fi
