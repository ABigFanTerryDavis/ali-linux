#!/bin/sh
# Odysseus v4 - ALI Linux long-task daemon.
# Started first at boot, stopped last at shutdown (see odysseus.service).
# Duties:
#   1. Boot-mode enforcer: Performance boot entry -> governor performance.
#   2. Health watchdog: disk/RAM/failed-units checks every 5 minutes.
#   3. Status feed: /run/odysseus-status for ALI Center (+ boot timing).
#   4. Update notifier: daily apt refresh -> /run/ali-updates (count).
#   5. Sentinel memory: archives security feed + firewall blocks at shutdown,
#      restores blocks at boot and reports what happened while away.
#   6. Sentinel watchdog: restarts Sentinel if it dies, screams if it won't.
LOG=/var/log/odysseus.log
STATUS=/run/odysseus-status
UPDATES=/run/ali-updates
SFEED=/run/ali-security
SARCH=/var/log/sentinel-archive.log
SBLOCKS=/var/lib/ali-sentinel/blocks.saved
ODSTATE=/var/lib/odysseus
LASTSHUT="$ODSTATE/last-shutdown"

log() {
  echo "$(date -u +%FT%TZ) odysseus: $1" >> "$LOG" 2>/dev/null || true
}

MODE="normal"
if grep -q "mitigations=off" /proc/cmdline 2>/dev/null; then
  MODE="performance"
fi
BOOTED_AT="$(date -u +%FT%TZ)"
BOOT_S="$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)"
case "$BOOT_S" in ''|*[!0-9]*) BOOT_S="?" ;; esac
mkdir -p "$ODSTATE" /var/lib/ali-sentinel 2>/dev/null || true

current_gov() {
  cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown"
}

write_status() {
  # $1 = last_warn (or empty)
  mkdir -p /run 2>/dev/null || true
  {
    echo "mode=$MODE"
    echo "governor=$(current_gov)"
    echo "booted_at=$BOOTED_AT"
    echo "boot_time_s=$BOOT_S"
    echo "last_shutdown=$(cat $LASTSHUT 2>/dev/null || echo never)"
    echo "last_check=$(date -u +%FT%TZ)"
    echo "updates=$(cat $UPDATES 2>/dev/null || echo unknown)"
    echo "sentinel=$(pgrep -x sentinel >/dev/null 2>&1 && echo alive || echo dead)"
    echo "last_warn=${1:-none}"
  } > "$STATUS" 2>/dev/null || true
}

enforce_mode() {
  want="$1"
  gov="$want"
  if [ "$want" = "normal" ]; then
    gov="powersave"
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors ]; then
      AVAIL="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)"
      case " $AVAIL " in
        *" schedutil "*) gov="schedutil" ;;
      esac
    fi
  fi
  if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
    echo "$gov" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || \
      log "governor set failed (wanted $gov)"
  fi
}

watchdog() {
  WARN=""
  USEP="$(df -P / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')"
  if [ -n "$USEP" ] && [ "$USEP" -ge 90 ] 2>/dev/null; then
    WARN="disk / at ${USEP}%"
    log "WARN $WARN"
  fi
  if command -v free >/dev/null 2>&1; then
    MPCT="$(free 2>/dev/null | awk '/^Mem:/ {printf "%d", $3/$2*100}')"
    if [ -n "$MPCT" ] && [ "$MPCT" -ge 90 ] 2>/dev/null; then
      WARN="ram at ${MPCT}%"
      log "WARN $WARN"
    fi
  fi
  if command -v systemctl >/dev/null 2>&1; then
    FAILED="$(systemctl --failed --no-legend 2>/dev/null | wc -l)"
    if [ "$FAILED" -gt 0 ] 2>/dev/null; then
      WARN="$FAILED failed unit(s)"
      log "WARN $WARN"
    fi
  fi
  if [ -n "$SENT_WARN" ]; then
    WARN="${WARN:+$WARN, }$SENT_WARN"
  fi
  write_status "$WARN"
}

sentinel_watch() {
  SENT_WARN=""
  if command -v pgrep >/dev/null 2>&1 && pgrep -x sentinel >/dev/null 2>&1; then
    return 0
  fi
  log "sentinel not running, attempting start"
  systemctl start sentinel 2>/dev/null || true
  sleep 3
  if command -v pgrep >/dev/null 2>&1 && pgrep -x sentinel >/dev/null 2>&1; then
    log "sentinel restarted by odysseus watchdog"
    echo "$(date '+%F %T') [INFO] Odysseus restarted Sentinel (it had died)" >> "$SFEED" 2>/dev/null || true
  else
    SENT_WARN="sentinel keeps dying"
    log "WARN $SENT_WARN"
    echo "$(date '+%F %T') [ALERT] Sentinel dead and restart failed - run: sudo systemctl status sentinel" >> "$SFEED" 2>/dev/null || true
  fi
}

sentinel_restore() {
  # boot: re-apply blocks saved at last shutdown, report the away period
  N=0
  if [ -f "$SBLOCKS" ] && command -v ufw >/dev/null 2>&1; then
    for ip in $(cat "$SBLOCKS" 2>/dev/null); do
      case "$ip" in *[!0-9.]*) continue ;; esac
      if ufw status 2>/dev/null | grep -q "DENY.*$ip"; then
        N=$((N + 1)); continue
      fi
      if ufw deny from "$ip" comment 'sentinel restored' >/dev/null 2>&1; then
        N=$((N + 1))
      fi
    done
  fi
  AWAY=""
  if [ -f "$LASTSHUT" ]; then
    AWAY="last shutdown $(cat $LASTSHUT 2>/dev/null); "
  fi
  if [ "$N" -gt 0 ] || [ -n "$AWAY" ]; then
    echo "$(date '+%F %T') [INFO] Odysseus: ${AWAY}restored $N firewall block(s), archive: $SARCH" >> "$SFEED" 2>/dev/null || true
    log "sentinel restore: ${AWAY}$N block(s)"
  fi
}

sentinel_archive() {
  # shutdown: persist feed + blocks to disk (/run is tmpfs, dies with us)
  {
    echo "--- shutdown $(date '+%F %T') ---"
    cat "$SFEED" 2>/dev/null
  } >> "$SARCH" 2>/dev/null || true
  if command -v ufw >/dev/null 2>&1; then
    ufw status 2>/dev/null | grep sentinel | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | sort -u > "$SBLOCKS" 2>/dev/null || true
  fi
  UP="$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)"
  echo "$(date -u +%FT%TZ) session_s=${UP:-?}" > "$LASTSHUT" 2>/dev/null || true
  log "archived sentinel feed + blocks (last to end)"
}

update_check() {
  # once per day: refresh apt lists, count upgradable
  TODAY="$(date -u +%F)"
  if [ -f /run/odysseus-apt-day ] && [ "$(cat /run/odysseus-apt-day 2>/dev/null)" = "$TODAY" ]; then
    return 0
  fi
  if command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq 2>/dev/null || true
    N="$(apt list --upgradable 2>/dev/null | grep -cv '^Listing')"
    echo "$N" > "$UPDATES" 2>/dev/null || true
    log "updates available: $N"
  fi
  echo "$TODAY" > /run/odysseus-apt-day 2>/dev/null || true
}

cleanup() {
  sentinel_archive
  log "stopping (last to end)"
  exit 0
}
trap cleanup TERM INT

log "starting (first to start) mode=$MODE"
enforce_mode "$MODE"
log "governor enforced for $MODE mode"
sentinel_restore
write_status ""
update_check

CYCLES=0
SENT_WARN=""
while true; do
  sleep 300
  CYCLES=$((CYCLES + 1))
  if [ "$MODE" = "performance" ]; then
    enforce_mode performance
  fi
  sentinel_watch
  watchdog
  # daily check approx: every 288th cycle
  if [ "$CYCLES" -ge 288 ]; then
    CYCLES=0
    update_check
  fi
done
