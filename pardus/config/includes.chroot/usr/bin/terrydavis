#!/bin/sh
# terrydavis - ALI QoL daemon (named for the TempleOS man: software with soul).
# Quiet background comfort:
#   1. Janitor: trims apt cache, stale /tmp, aging trash + caches (hourly).
#   2. Town crier: Odysseus warnings + pending updates -> desktop pings.
#   3. USB announcer: pings when a removable drive appears (15s).
#   4. Game mode: fullscreen app -> performance governor + quiet crier (15s).
#   5. WiFi watchdog: nudges NetworkManager back up, pings if it can't (1m).
#   6. Night light: redshift after 21:00, off at 06:00 (hourly).
#   7. Download sorter: files ~/Downloads by extension, skips fresh (15s).
#   8. Coffee mode: inhibits suspend while SSH/media is active (1m).
#   9. Crash catcher: fresh coredumps become a visible ping (hourly).
set -u
STATE=/var/lib/terrydavis
STATUS=/run/terrydavis-status
LOG=/var/log/terrydavis.log
FAST=15
WIFI_EVERY=4      # 4 x 15s = 1m
SLOW_EVERY=240    # 240 x 15s = 1h
ALI_HOME=/home/ali
DL_DIR="$ALI_HOME/Downloads"

mkdir -p "$STATE"
touch "$LOG" 2>/dev/null || true

log() {
    echo "$(date '+%F %T') terrydavis: $1" >> "$LOG" 2>/dev/null || true
}

ping() {
    # $1 = title, $2 = message. Best-effort desktop notification.
    if command -v notify-send >/dev/null 2>&1 && id ali >/dev/null 2>&1; then
        uid=$(id -u ali)
        sudo -u ali DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
            notify-send "$1" "$2" 2>/dev/null || true
    fi
    logger -t terrydavis "$1: $2" 2>/dev/null || true
}

write_status() {
    mkdir -p /run 2>/dev/null || true
    {
        echo "last_janitor=$(cat $STATE/last-janitor 2>/dev/null || echo never)"
        echo "last_freed_kb=$(cat $STATE/last-freed 2>/dev/null || echo 0)"
        echo "last_notice=$(cat $STATE/last-notice 2>/dev/null || echo none)"
        echo "usb_last=$(cat $STATE/usb-last 2>/dev/null || echo none)"
        echo "game_mode=$(cat $STATE/gamemode 2>/dev/null || echo off)"
        echo "night_light=$(pgrep -x redshift >/dev/null 2>&1 && echo on || echo off)"
        echo "wifi=$(nmcli -t -f STATE g 2>/dev/null || echo unknown)"
        echo "coffee=$([ -f $STATE/coffee.pid ] && pgrep -F $STATE/coffee.pid >/dev/null 2>&1 && echo on || echo off)"
        echo "crashes=$(cat $STATE/crash-count 2>/dev/null || echo 0)"
        echo "last_sort=$(cat $STATE/last-sort 2>/dev/null || echo never)"
        echo "last_check=$(date '+%F %T')"
    } > "$STATUS" 2>/dev/null || true
}

kb_free() {
    # $1 = dir. Prints size in KB (0 if missing).
    du -sk "$1" 2>/dev/null | awk '{print $1}'
}

janitor() {
    before=$(($(kb_free "$ALI_HOME/.cache") + $(kb_free /var/cache/apt/archives) + $(kb_free /tmp)))
    # apt: drop only packages that can no longer be downloaded (safe)
    apt-get autoclean -qq >/dev/null 2>&1 || true
    # /tmp: files untouched for 10+ days
    find /tmp -mindepth 1 -type f -atime +10 -delete 2>/dev/null || true
    # trash: files deleted 30+ days ago
    if [ -d "$ALI_HOME/.local/share/Trash/files" ]; then
        find "$ALI_HOME/.local/share/Trash/files" -mindepth 1 -mtime +30 -delete 2>/dev/null || true
    fi
    # app caches: files unopened for 14+ days (apps rebuild these)
    if [ -d "$ALI_HOME/.cache" ]; then
        find "$ALI_HOME/.cache" -type f -atime +14 -delete 2>/dev/null || true
    fi
    after=$(($(kb_free "$ALI_HOME/.cache") + $(kb_free /var/cache/apt/archives) + $(kb_free /tmp)))
    freed=$((before - after))
    [ "$freed" -lt 0 ] && freed=0
    echo "$(date '+%F %T')" > "$STATE/last-janitor"
    echo "$freed" > "$STATE/last-freed"
    log "janitor freed ${freed}KB"
    if [ "$freed" -ge 102400 ]; then
        ping "ALI Janitor" "cleaned up $((freed / 1024))MB of stale caches and trash"
        echo "janitor freed $((freed / 1024))MB" > "$STATE/last-notice"
    fi
    write_status
}

gaming_now() {
    # stdin helper: 0 (true) if the active window is fullscreen.
    command -v xprop >/dev/null 2>&1 || return 1
    [ -n "${DISPLAY:-}" ] || DISPLAY=":0"
    export DISPLAY
    win=$(sudo -u ali DISPLAY="$DISPLAY" xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk -F' ' '{print $NF}')
    case "$win" in 0x*|*[0-9]*) ;;
        *) return 1 ;;
    esac
    sudo -u ali DISPLAY="$DISPLAY" xprop -id "$win" _NET_WM_STATE 2>/dev/null | grep -q FULLSCREEN
}

set_gov() {
    # $1 = performance|normal. Mirrors odysseus governor logic.
    want="$1"
    gov="$want"
    if [ "$want" = "normal" ]; then
        gov="powersave"
        if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors ]; then
            AVAIL="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)"
            case " $AVAIL " in
                *" schedutil "*) gov="schedutil" ;;
            esac
        fi
    fi
    if grep -q "mitigations=off" /proc/cmdline 2>/dev/null; then
        gov="performance"  # Performance boot entry always wants full speed
    fi
    if [ -d /sys/devices/system/cpu/cpu0/cpufreq ]; then
        echo "$gov" | tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
    fi
}

game_check() {
    if gaming_now; then
        if [ "$(cat $STATE/gamemode 2>/dev/null)" != "on" ]; then
            echo on > "$STATE/gamemode"
            date +%s > "$STATE/gamemode.since"
            set_gov performance
            log "game mode ON (fullscreen app, governor performance)"
            write_status
        else
            date +%s > "$STATE/gamemode.since"
        fi
    else
        if [ "$(cat $STATE/gamemode 2>/dev/null)" = "on" ]; then
            echo off > "$STATE/gamemode"
            set_gov normal
            log "game mode OFF (governor restored)"
            write_status
        fi
    fi
}

crier() {
    # Odysseus warnings -> one notification per new warning
    if [ -f /run/odysseus-status ]; then
        warn=$(grep -a '^last_warn=' /run/odysseus-status 2>/dev/null | cut -d= -f2-)
        old=$(cat "$STATE/notified.warn" 2>/dev/null)
        if [ -n "$warn" ] && [ "$warn" != "none" ] && [ "$warn" != "$old" ]; then
            ping "ALI Health" "$warn"
            echo "$warn" > "$STATE/notified.warn"
            echo "health: $warn" > "$STATE/last-notice"
            log "cried about: $warn"
        fi
    fi
    # pending updates -> once per day (skipped while gaming: non-urgent)
    if [ "$(cat $STATE/gamemode 2>/dev/null)" = "on" ]; then
        write_status
        return 0
    fi
    if [ -f /run/ali-updates ]; then
        n=$(cat /run/ali-updates 2>/dev/null)
        today=$(date +%F)
        case "$n" in ''|*[!0-9]*|0) ;; *)
            if [ "$(cat $STATE/notified.upd 2>/dev/null)" != "$today" ]; then
                ping "ALI Updates" "$n update(s) pending - run ali-update when ready"
                echo "$today" > "$STATE/notified.upd"
                echo "$n updates pending" > "$STATE/last-notice"
                log "cried about: $n updates"
            fi ;;
        esac
    fi
    write_status
}

usb_announce() {
    if ! command -v lsblk >/dev/null 2>&1; then return 0; fi
    cur="$STATE/usb.cur"
    lsblk -rpn -o NAME,RM,LABEL,SIZE,MOUNTPOINT 2>/dev/null | awk '$2==1 {print $1"|"$3"|"$4"|"$5}' | sort > "$cur"
    if [ ! -f "$STATE/usb.seen" ]; then
        cp "$cur" "$STATE/usb.seen"
        return 0
    fi
    added=$(comm -13 "$STATE/usb.seen" "$cur")
    if [ -n "$added" ]; then
        echo "$added" | while IFS='|' read -r dev label size mnt; do
            what="${label:-$dev} (${size})"
            if [ -n "$mnt" ] && [ "$mnt" != "" ]; then
                ping "ALI USB" "$what plugged in, mounted at $mnt"
            else
                ping "ALI USB" "$what plugged in - open Files to mount it"
            fi
            echo "$what" > "$STATE/usb-last"
            log "usb: $what (mnt: ${mnt:-none})"
        done
        cp "$cur" "$STATE/usb.seen"
        write_status
    fi
    # drives unplugged: forget them so replug re-announces
    if [ -z "$added" ]; then
        cp "$cur" "$STATE/usb.seen"
    fi
}

wifi_check() {
    if ! command -v nmcli >/dev/null 2>&1; then return 0; fi
    st=$(nmcli -t -f STATE g 2>/dev/null)
    if [ "$st" = "connected" ]; then
        rm -f "$STATE/wifi-down"
        return 0
    fi
    # no usable connection: nudge the stack awake, then re-check
    log "wifi state: ${st:-unknown}, nudging"
    nmcli networking on >/dev/null 2>&1 || true
    nmcli radio wifi on >/dev/null 2>&1 || true
    sleep 20
    st2=$(nmcli -t -f STATE g 2>/dev/null)
    if [ "$st2" = "connected" ]; then
        rm -f "$STATE/wifi-down"
        log "wifi recovered after nudge"
        return 0
    fi
    if [ ! -f "$STATE/wifi-down" ]; then
        ping "ALI WiFi" "connection is down and won't come back - check the NetworkManager applet"
        echo "$(date '+%F %T')" > "$STATE/wifi-down"
        echo "wifi down" > "$STATE/last-notice"
        log "cried about: wifi down"
        write_status
    fi
}

coffee_check() {
    # suspend makes no sense mid-transfer or mid-movie: hold an inhibitor
    # while SSH sessions or media players are active, release after.
    need=0
    if command -v ss >/dev/null 2>&1; then
        if ss -tn state established 2>/dev/null | grep -qE ':22[[:space:]]'; then need=1; fi
    fi
    if [ "$need" = "0" ] && command -v pgrep >/dev/null 2>&1; then
        if pgrep -xE 'mpv|vlc|totem|celluloid|parole' >/dev/null 2>&1; then need=1; fi
    fi
    if [ ! -d /run/systemd/system ]; then return 0; fi  # no systemd, no inhibitors
    if [ "$need" = "1" ]; then
        if [ -f "$STATE/coffee.pid" ] && pgrep -F "$STATE/coffee.pid" >/dev/null 2>&1; then return 0; fi
        systemd-inhibit --what=sleep:idle --who=terrydavis --why='coffee mode: ssh/media active' sleep infinity >/dev/null 2>&1 &
        echo $! > "$STATE/coffee.pid"
        log "coffee mode ON (suspend inhibited)"
        write_status
    else
        if [ -f "$STATE/coffee.pid" ]; then
            kill "$(cat $STATE/coffee.pid 2>/dev/null)" 2>/dev/null || true
            rm -f "$STATE/coffee.pid"
            # the sleep may have been reparented; sweep leftovers
            pkill -f 'sleep infinity' 2>/dev/null || true
            log "coffee mode OFF"
            write_status
        fi
    fi
}

crash_check() {
    # coredumps die in silence; make the latest one visible (once each).
    total=0
    if command -v coredumpctl >/dev/null 2>&1; then
        total=$(coredumpctl --no-legend --no-pager 2>/dev/null | wc -l)
    fi
    if [ -d /var/crash ]; then
        total=$((total + $(ls /var/crash/*.crash 2>/dev/null | wc -l)))
    fi
    old=$(cat "$STATE/crash-count" 2>/dev/null || echo 0)
    case "$old" in ''|*[!0-9]*) old=0 ;; esac
    echo "$total" > "$STATE/crash-count"
    if [ "$total" -gt "$old" ]; then
        ping "ALI Crash" "$((total - old)) new crash(es) - run: coredumpctl list"
        echo "$((total - old)) new crash(es)" > "$STATE/last-notice"
        log "cried about: $((total - old)) crash(es)"
        write_status
    fi
}

night_check() {
    if ! command -v redshift >/dev/null 2>&1; then return 0; fi
    if ! id ali >/dev/null 2>&1; then return 0; fi
    uid=$(id -u ali)
    h=$(date +%H)
    night=0
    if [ "$h" -ge 21 ] || [ "$h" -lt 6 ]; then night=1; fi
    if [ "$night" = "1" ]; then
        if ! pgrep -x redshift >/dev/null 2>&1; then
            sudo -u ali DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
                redshift -t 5700:3500 >/dev/null 2>&1 &
            log "night light ON"
            write_status
        fi
    else
        if pgrep -x redshift >/dev/null 2>&1; then
            pkill -x redshift 2>/dev/null || true
            log "night light OFF"
            write_status
        fi
    fi
}

sorter() {
    [ -d "$DL_DIR" ] || return 0
    moved=0
    for f in "$DL_DIR"/*; do
        [ -f "$f" ] || continue
        # skip files modified in the last 2 minutes (downloads in flight)
        if [ -n "$(find "$f" -mmin -2 2>/dev/null)" ]; then continue; fi
        case "${f##*.}" in
            iso|img|IMG|ISO) dest="$DL_DIR/ISOs" ;;
            jpg|jpeg|png|gif|webp|svg|JPG|PNG) dest="$DL_DIR/Pictures" ;;
            mp4|mkv|webm|avi|mov|MP4|MKV) dest="$DL_DIR/Videos" ;;
            mp3|flac|ogg|wav|MP3|FLAC) dest="$DL_DIR/Music" ;;
            zip|rar|7z|tar|gz|bz2|xz|deb|ZIP) dest="$DL_DIR/Archives" ;;
            pdf|epub|txt|doc|docx|odt|PDF) dest="$DL_DIR/Documents" ;;
            *) continue ;;
        esac
        case "$f" in */ISOs/*|*/Pictures/*|*/Videos/*|*/Music/*|*/Archives/*|*/Documents/*) continue ;; esac
        mkdir -p "$dest"
        if mv "$f" "$dest/" 2>/dev/null; then
            moved=$((moved + 1))
        fi
    done
    if [ "$moved" -gt 0 ]; then
        echo "$(date '+%F %T') ($moved file(s))" > "$STATE/last-sort"
        log "sorter filed $moved download(s)"
        write_status
    fi
}

announce_once() {
    # `terrydavis --once`: one full pass now.
    janitor
    crier
    usb_announce
    game_check
    wifi_check
    coffee_check
    night_check
    sorter
    crash_check
    write_status
}

case "${1:-}" in
    --once) announce_once ;;
    *)  log "starting (QoL: janitor + crier + usb + game + wifi + night + sorter + coffee + crash)"
        write_status
        n=0
        w=0
        while true; do
            usb_announce
            game_check
            sorter
            w=$((w + 1))
            if [ "$w" -ge "$WIFI_EVERY" ]; then
                w=0
                wifi_check
                coffee_check
            fi
            n=$((n + 1))
            if [ "$n" -ge "$SLOW_EVERY" ]; then
                n=0
                janitor
                crier
                night_check
                crash_check
            fi
            sleep "$FAST"
        done ;;
esac
