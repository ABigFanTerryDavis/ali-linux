#!/bin/sh
# ali-sentinel - operator CLI for ALI Sentinel (IDS alerts + IPS blocks)
# usage: ali-sentinel status|events|blocked|unblock <ip>|learn|check|kill <pid>
# Turkish: ALI_LANG=tr ali-sentinel ...
set -u
FEED=/run/ali-security

TR() {
    # $1 = en, $2 = tr
    if [ "${ALI_LANG:-}" = "tr" ] || [ "${ALI_LANG:-}" = "TR" ]; then
        printf '%s' "$2"
    else
        printf '%s' "$1"
    fi
}

case "${1:-status}" in
    status)
        if pgrep -x sentinel >/dev/null 2>&1; then echo "$(TR 'Sentinel: running (IDS watch + IPS exterminate)' 'Sentinel: çalışıyor (IDS izleme + IPS engelleme)')"; else echo "$(TR 'Sentinel: NOT running' 'Sentinel: ÇALIŞMIYOR')"; fi
        if command -v ufw >/dev/null 2>&1; then ufw status 2>/dev/null | grep -c DENY | xargs echo "$(TR 'IPs exterminated:' 'Yok edilen IP:')"; fi
        echo "--- $(TR 'latest events' 'son olaylar') ---"
        tail -n 10 "$FEED" 2>/dev/null || echo "$(TR '(no events yet)' '(henüz olay yok)')"
        ;;
    events)
        cat "$FEED" 2>/dev/null || echo "$(TR '(no events yet)' '(henüz olay yok)')"
        ;;
    blocked)
        ufw status 2>/dev/null | grep -E "DENY.*sentinel" || echo "$(TR '(no sentinel blocks)' '(sentinel engeli yok)')"
        ;;
    unblock)
        ip="${2:?$(TR 'usage: ali-sentinel unblock <ip>' 'kullanım: ali-sentinel unblock <ip>')}"
        ufw delete deny from "$ip"
        echo "$(date '+%F %T') [INFO] operator unblocked $ip" >> "$FEED"
        ;;
    learn)
        echo "$(TR 'Re-learning baselines (current ports/files become trusted)...' 'Referanslar yeniden öğreniliyor (mevcut portlar/dosyalar güvenilir sayılacak)...')"
        sentinel learn
        ;;
    check)
        echo "$(TR 'Running one Sentinel scan now...' 'Sentinel taraması yapılıyor...')"
        sudo sentinel --once
        tail -n 10 "$FEED" 2>/dev/null
        ;;
    kill)
        pid="${2:?$(TR 'usage: ali-sentinel kill <pid>' 'kullanım: ali-sentinel kill <pid>')}"
        case "$pid" in 1) echo "$(TR 'refusing to kill init' 'init öldürülmez')"; exit 1 ;; esac
        if sudo kill -9 "$pid" 2>/dev/null; then
            echo "$(date '+%F %T') [INFO] operator terminated pid $pid" >> "$FEED"
            echo "pid $pid $(TR 'terminated' 'sonlandırıldı')"
        else
            echo "$(TR "could not kill $pid" "$pid öldürülemedi")"
            exit 1
        fi
        ;;
    *)
        echo "$(TR 'usage: ali-sentinel status|events|blocked|unblock <ip>|learn|check|kill <pid>' 'kullanım: ali-sentinel status|events|blocked|unblock <ip>|learn|check|kill <pid>')"
        exit 1
        ;;
esac
