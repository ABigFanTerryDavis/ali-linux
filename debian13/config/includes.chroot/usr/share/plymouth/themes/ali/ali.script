# ALI splash: dark background, dice mark, title, progress bar.
# bg.png / bar-bg.png / bar-fill.png are generated at build time by the
# branding hook (stdlib python3, solid colors - zero asset deps).
# dice.png is the canonical logo (transparent, shipped with the theme).
bg = Image("bg.png");
bg_sp = Sprite(bg);
bg_sp.SetPosition(Window.GetX(), Window.GetY(), -10);

dice = Image("dice.png");
dice_sp = Sprite(dice);
dice_sp.SetPosition(
    Window.GetX() + (Window.GetWidth() - 500) / 2,
    Window.GetY() + (Window.GetHeight() - 500) / 2 - 130, 10);

title = Image.Text("ALI Linux", 1, 1, 1, "Sans 64");
ts = Sprite(title);
ts.SetPosition(
    Window.GetX() + (Window.GetWidth() - title.GetWidth()) / 2,
    Window.GetY() + (Window.GetHeight() - 500) / 2 + 390, 10);

sub = Image.Text("XFCE", 0.55, 0.58, 0.72, "Sans 24");
ss = Sprite(sub);
ss.SetPosition(
    Window.GetX() + (Window.GetWidth() - sub.GetWidth()) / 2,
    Window.GetY() + (Window.GetHeight() - 500) / 2 + 390 + title.GetHeight() + 10, 10);

bar_w = 600;
bar_h = 20;
bx = Window.GetX() + (Window.GetWidth() - bar_w) / 2;
by = Window.GetY() + Window.GetHeight() * 0.86;

bar_bg = Image("bar-bg.png");
bbs = Sprite(bar_bg);
bbs.SetPosition(bx, by, 10);

bar_fill = Image("bar-fill.png");
bfs = Sprite(bar_fill);
bfs.SetPosition(bx, by, 11);
bfs.SetClip(bx, by, 0, bar_h);

fun progress_callback(duration, progress) {
    if (progress > 1) {
        progress = 1;
    }
    bfs.SetClip(bx, by, Math.Int(bar_w * progress), bar_h);
}
Plymouth.SetBootProgressFunction(progress_callback);

fun message_callback(text) {
}
Plymouth.SetMessageFunction(message_callback);

fun password_callback(prompt, bullets) {
    pw = Image.Text(prompt, 1, 1, 1, "Sans 28");
    pws = Sprite(pw);
    pws.SetPosition(Window.GetX() + (Window.GetWidth() - pw.GetWidth()) / 2,
        Window.GetY() + Window.GetHeight() * 0.80, 10);
    bl = Image.Text(bullets, 0.55, 0.58, 0.72, "Sans 28");
    bls = Sprite(bl);
    bls.SetPosition(Window.GetX() + (Window.GetWidth() - bl.GetWidth()) / 2,
        Window.GetY() + Window.GetHeight() * 0.80 + 40, 10);
}
Plymouth.SetPasswordFunction(password_callback);

fun quit_callback() {
}
Plymouth.SetQuitFunction(quit_callback);
