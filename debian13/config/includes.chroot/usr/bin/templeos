#!/bin/sh
# templeos - ALI tribute daemon (God's third temple energy, zero utility, all soul).
#   1. Oracle: TempleOS spat God's random words; ours posts one on boot and
#      hourly - a WORD plus a verse - to /run/templeos-oracle + desktop ping.
#   2. Daily verse: date-seeded pick, shown in the feed and ALI Center.
#      (`ali-oracle` asks the oracle right now.)
set -u
STATE=/var/lib/templeos
FEED=/run/templeos-oracle
LOG=/var/log/templeos.log
mkdir -p "$STATE"
touch "$LOG" 2>/dev/null || true

WORDS="KINGDOM ANGEL CHARIOT TRUMPET RIVER STONE EAGLE LION BREAD LIGHT
THRONE ALTAR CLOUD FIRE WIND SEED HARVEST DOOR LAMP SWORD SHIELD STAR
MOUNTAIN VALLEY WELL GATE TOWER WHEAT OIL WINE MILK HONEY SALT PEARL
ANCHOR ARROW BOW CROWN ROBE SANDAL SCROLL SEAL VOICE DREAM VISION
PSALM HARP DRUM DANCE FEAST TABLE CUP PLATE LOAF FISH DOVE LAMB WOLF
SHEPHERD FLOCK FIELD GARDEN DESERT OASIS RAINBOW THUNDER FROST DEW MIST"

VERSES="Be still, and know. | The heavens declare the glory. | Make a joyful noise.
Let there be light. | The Lord is my shepherd. | This is the day that was made; rejoice.
Seek, and ye shall find. | Great is His faithfulness. | Sing unto Him a new song.
The joy of the Lord is your strength. | What matters is: do you believe? - Terry
I am smart, I can do everything. - Terry | The worst thing you can do is nothing. - Terry"

log() {
    echo "$(date '+%F %T') templeos: $1" >> "$LOG" 2>/dev/null || true
}

ping() {
    if command -v notify-send >/dev/null 2>&1 && id ali >/dev/null 2>&1; then
        uid=$(id -u ali)
        sudo -u ali DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
            notify-send "$1" "$2" 2>/dev/null || true
    fi
}

pick_word() {
    echo "$WORDS" | tr ' ' '\n' | grep -v '^$' | shuf -n1 2>/dev/null || echo "LIGHT"
}

pick_verse() {
    # $1 = seed (day number or RANDOM). Date-seeded = same verse all day.
    seed="${1:-$RANDOM}"
    echo "$VERSES" | tr '|' '\n' | awk -v s="$seed" 'BEGIN{srand(s)} {v[NR]=$0} END{print v[(s%NR)+1]}'
}

consult() {
    # $1 = occasion (boot|hour|asked). Writes feed, pings on boot/hour.
    word=$(pick_word)
    daynum=$(date +%j)
    verse=$(pick_verse "$daynum")
    {
        echo "oracle=$word"
        echo "verse=$verse"
        echo "consulted=$(date '+%F %T') ($1)"
    } > "$FEED" 2>/dev/null || true
    log "oracle consulted ($1): $word"
    if [ "$1" != "silent" ]; then
        ping "ALI Oracle" "$word - $verse"
    fi
}

case "${1:-}" in
    --once) consult asked ;;
    verse) pick_verse "$(date +%j)" ;;
    *)  log "starting (oracle + verse)"
        consult boot
        n=0
        lastday=""
        while true; do
            sleep 60
            n=$((n + 1))
            today=$(date +%F)
            if [ "$today" != "$lastday" ]; then
                lastday="$today"
                consult hour
                n=0
            elif [ "$n" -ge 60 ]; then
                n=0
                consult hour
            fi
        done ;;
esac
