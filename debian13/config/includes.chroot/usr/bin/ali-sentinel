#!/bin/sh
# ali-sentinel - operator CLI for ALI Sentinel (IDS alerts + IPS blocks)
# usage: ali-sentinel status|events|blocked|unblock <ip>|learn|check|kill <pid>
set -u
FEED=/run/ali-security

case "${1:-status}" in
    status)
        if pgrep -x sentinel >/dev/null 2>&1; then echo "Sentinel: running (IDS watch + IPS exterminate)"; else echo "Sentinel: NOT running"; fi
        if command -v ufw >/dev/null 2>&1; then ufw status 2>/dev/null | grep -c DENY | xargs echo "IPs exterminated:"; fi
        echo "--- latest events ---"
        tail -n 10 "$FEED" 2>/dev/null || echo "(no events yet)"
        ;;
    events)
        cat "$FEED" 2>/dev/null || echo "(no events yet)"
        ;;
    blocked)
        ufw status 2>/dev/null | grep -E "DENY.*sentinel" || echo "(no sentinel blocks)"
        ;;
    unblock)
        ip="${2:?usage: ali-sentinel unblock <ip>}"
        ufw delete deny from "$ip"
        echo "$(date '+%F %T') [INFO] operator unblocked $ip" >> "$FEED"
        ;;
    learn)
        echo "Re-learning baselines (current ports/files become trusted)..."
        sentinel learn
        ;;
    check)
        echo "Running one Sentinel scan now..."
        sudo sentinel --once
        tail -n 10 "$FEED" 2>/dev/null
        ;;
    kill)
        pid="${2:?usage: ali-sentinel kill <pid>}"
        case "$pid" in 1) echo "refusing to kill init"; exit 1 ;; esac
        if sudo kill -9 "$pid" 2>/dev/null; then
            echo "$(date '+%F %T') [INFO] operator terminated pid $pid" >> "$FEED"
            echo "pid $pid terminated"
        else
            echo "could not kill $pid"
            exit 1
        fi
        ;;
    *)
        echo "usage: ali-sentinel status|events|blocked|unblock <ip>|learn|check|kill <pid>"
        exit 1
        ;;
esac
