#!/bin/sh
set -e
# ALI Linux branding hook - runs inside chroot
# Overwrites base-files on every build so branding survives upgrades in the live system

cat > /etc/os-release <<'EOF'
PRETTY_NAME="ALI Linux 1.4.8"
NAME="ALI Linux"
VERSION_ID="1.4.8"
VERSION="1.4.8"
ID=ali
ID_LIKE=debian
HOME_URL="https://github.com/"
DEBIAN_VERSION_FULL=13
EOF

cat > /etc/lsb-release <<'EOF'
DISTRIB_ID="ALI Linux"
DISTRIB_RELEASE=1.4.8
DISTRIB_CODENAME=ali
DISTRIB_DESCRIPTION="ALI Linux 1.4.8"
EOF

echo "ali" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 ali
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

echo "ALI Linux 1.4.8 \\n \\l" > /etc/issue
echo "ALI Linux 1.4.8" > /etc/issue.net
echo "ALI Linux 1.4.8" > /etc/motd
if [ -f /usr/share/ali/mascot.txt ]; then
  cat /usr/share/ali/mascot.txt >> /etc/motd 2>/dev/null || true
fi

# LightDM greeter branding if present
if [ -d /etc/lightdm ]; then
  mkdir -p /etc/lightdm
  cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'EOF'
[greeter]
background=/usr/share/backgrounds/ali/default.jpg
logo=/usr/share/ali/logo.png
theme-name=Greybird
icon-theme-name=elementary-xfce
font-name=Cantarell 11
xft-antialias=true
show-clock=true
clock-format=%H:%M
indicators=~host;~spacer;~clock;~spacer;~session;~a11y;~power
EOF
fi

# Simple wallpaper
mkdir -p /usr/share/backgrounds/ali
cat > /usr/share/backgrounds/ali/ali-wallpaper.svg <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080"><rect width="100%" height="100%" fill="#1a1d29"/><text x="50%" y="48%" font-family="sans-serif" font-size="120" fill="#ffffff" text-anchor="middle">ALI Linux</text><text x="50%" y="58%" font-family="sans-serif" font-size="36" fill="#8b93b8" text-anchor="middle">XFCE</text></svg>
EOF

# ALI Terminal + commands visible rebrand - wrappers come from includes.chroot
chmod +x /usr/bin/ali-terminal /usr/bin/ali-update /usr/bin/ali-info /usr/bin/ali-perf /usr/bin/ali-normal /usr/bin/ali-mirrors /usr/bin/ali-game /usr/bin/ali-alarm /usr/bin/ali-update-version /usr/bin/ali-backup /usr/bin/hcc /usr/bin/terry /usr/bin/ali-sentinel /usr/bin/odysseus /usr/bin/sentinel /usr/bin/terrydavis /usr/bin/templeos /usr/bin/ali-oracle /usr/bin/ali-retro /usr/bin/terry-dice /usr/bin/ali-passgen /usr/bin/ali-vault /usr/bin/oracle /usr/bin/risestothrone 2>/dev/null || true

# Odysseus - enable first-up last-down task (symlink; git can't store it)
mkdir -p /etc/systemd/system/sysinit.target.wants
ln -sf /usr/lib/systemd/system/odysseus.service /etc/systemd/system/sysinit.target.wants/odysseus.service || true

# Sentinel - enable IDS watch + IPS exterminate daemon (symlink; git can't store it)
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /usr/lib/systemd/system/sentinel.service /etc/systemd/system/multi-user.target.wants/sentinel.service || true

# terrydavis - enable QoL daemon (janitor + crier + usb)
ln -sf /usr/lib/systemd/system/terrydavis.service /etc/systemd/system/multi-user.target.wants/terrydavis.service || true

# templeos - enable tribute daemon (oracle + verse)
ln -sf /usr/lib/systemd/system/templeos.service /etc/systemd/system/multi-user.target.wants/templeos.service || true

# oracle - enable security voice (verdicts + lots)
ln -sf /usr/lib/systemd/system/oracle.service /etc/systemd/system/multi-user.target.wants/oracle.service || true

# risestothrone - enable farewell guardian (shutdown ritual)
ln -sf /usr/lib/systemd/system/risestothrone.service /etc/systemd/system/multi-user.target.wants/risestothrone.service || true

# ALI security defaults - firewall + automatic security updates
if command -v ufw >/dev/null 2>&1; then
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true
  ufw --force enable >/dev/null 2>&1 || true
fi
mkdir -p /etc/apt/apt.conf.d
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APT::Periodic::Unattended-Upgrade "1";
EOF

# ALI safe-rm - source the guard in every interactive bash shell (login via
# profile.d file above, non-login here). Idempotent append.
if [ -f /etc/bash.bashrc ] && ! grep -q "ali-safe-rm.sh" /etc/bash.bashrc 2>/dev/null; then
  echo '[ -f /etc/ali-safe-rm.sh ] && . /etc/ali-safe-rm.sh' >> /etc/bash.bashrc || true
fi
# ALI terminal billboard - fastfetch on every interactive terminal (1.4.8)
if [ -f /etc/bash.bashrc ] && ! grep -q "ALI terminal billboard" /etc/bash.bashrc 2>/dev/null; then
  cat >> /etc/bash.bashrc <<'EOF' || true
# ALI terminal billboard
if command -v fastfetch >/dev/null 2>&1 && [ -t 1 ]; then
  fastfetch 2>/dev/null || true
fi
EOF
fi
# Hide stock XFCE terminal so only "ALI Terminal" shows in menus
for d in /usr/share/applications; do
  if [ -f "$d/xfce4-terminal.desktop" ]; then
    if grep -q "^NoDisplay=" "$d/xfce4-terminal.desktop"; then
      sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$d/xfce4-terminal.desktop"
    else
      echo "NoDisplay=true" >> "$d/xfce4-terminal.desktop"
    fi
  fi
done

# GRUB distributor branding (installed-system grub, live menu handled by 0990 hook)
mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/ali.cfg <<'EOF'
GRUB_DISTRIBUTOR="ALI Linux"
GRUB_BACKGROUND="/usr/share/backgrounds/ali/default.jpg"
GRUB_THEME="/boot/grub/themes/ali/theme.txt"
GRUB_GFXMODE="1920x1080,auto"
EOF
# installed-system theme background (git can't store big binaries twice - copy here)
mkdir -p /boot/grub/themes/ali
if [ -f /usr/share/backgrounds/ali/default.jpg ]; then
  cp /usr/share/backgrounds/ali/default.jpg /boot/grub/themes/ali/background.jpg 2>/dev/null || true
fi

# Keyboard default: us+tr, Alt+Shift toggles (X + console)
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="us,tr"
XKBVARIANT=""
XKBOPTIONS="grp:alt_shift_toggle"
BACKSPACE="guess"
EOF

# Plymouth ALI splash: theme ships via includes.chroot, solid PNGs are
# generated here with stdlib python3 (zero asset deps), then embedded.
if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ -d /usr/share/plymouth/themes/ali ]; then
  python3 - <<'PYEOF' 2>/dev/null || true
import struct, zlib

def png(path, w, h, rgb):
    raw = b''.join(b'\x00' + bytes(rgb) * w for _ in range(h))
    def chunk(t, d):
        c = struct.pack('>I', len(d)) + t + d
        return c + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    data = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', ihdr)
    data += chunk(b'IDAT', zlib.compress(raw))
    data += chunk(b'IEND', b'')
    open(path, 'wb').write(data)

d = '/usr/share/plymouth/themes/ali/'
png(d + 'bg.png', 1920, 1080, (26, 29, 41))
png(d + 'bar-bg.png', 600, 20, (42, 47, 69))
png(d + 'bar-fill.png', 600, 20, (139, 147, 184))
PYEOF
  plymouth-set-default-theme ali 2>/dev/null || plymouth-set-default-theme text 2>/dev/null || true
  update-initramfs -u 2>/dev/null || true
fi

# Live session polish - autologin + passwordless sudo (git can't keep 0440, so enforce here)
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/ali-autologin.conf <<'EOF'
[Seat:*]
autologin-user=ali
autologin-user-timeout=0
greeter-session=lightdm-gtk-greeter
EOF
mkdir -p /etc/sudoers.d
echo "ali ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ali-live
chmod 0440 /etc/sudoers.d/ali-live || true

# fastfetch ALI logo (authoritative - includes.chroot carries the same files for review)
mkdir -p /usr/share/ali /etc/skel/.config/fastfetch
cat > /usr/share/ali/fastfetch-logo.txt <<'EOF'
    ___    __    ____
   /   |  / /   /  _/
  / /| | / /    / /
 / ___ |/ /___ / /
/_/  |_/_____/___/

ALI Linux 1.4.8 - XFCE
EOF
cat > /etc/skel/.config/fastfetch/config.jsonc <<'EOF'
{
  "logo": {
    "type": "file",
    "source": "/usr/share/ali/fastfetch-logo.txt"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "de",
    "wm",
    "theme",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "break"
  ]
}
EOF

# Flatpak + Flathub (1.4.8) - newer apps on the stable base
if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --system --if-not-exists flathub \
    https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
fi
# KDE Connect lane through the firewall (1.4.8)
if command -v ufw >/dev/null 2>&1; then
  ufw allow 1714:1764/tcp comment 'kdeconnect' 2>/dev/null || true
  ufw allow 1714:1764/udp comment 'kdeconnect' 2>/dev/null || true
  # SSH rate-limit (1.4.8): throttled before Sentinel even sees it
  ufw limit 22/tcp comment 'ssh rate-limit' 2>/dev/null || true
fi
# TempleOS wallpapers: webp -> png at build (universal renderers), then drop webp
if command -v dwebp >/dev/null 2>&1; then
  for w in /usr/share/backgrounds/ali/*.webp; do
    [ -f "$w" ] || continue
    if dwebp "$w" -o "${w%.webp}.png" >/dev/null 2>&1; then
      rm -f "$w"
    fi
  done
fi
# ALI icon (menu button) - refresh cache so hicolor picks up ali-logo
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
fi
# man pages ship via includes.chroot - rebuild the index
if command -v mandb >/dev/null 2>&1; then
  mandb -q 2>/dev/null || true
fi

echo "ALI branding applied"
